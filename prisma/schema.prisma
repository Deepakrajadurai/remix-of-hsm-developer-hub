generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "mysql"
  url      = "mysql://dev-community:hsmdev282930@localhost:3306/dev_community"
}

model User {
  id            String    @id @default(uuid()) @db.Char(36)
  email         String    @unique
  password_hash String?   
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  
  // Relations
  // profile       Profile? 
  // posts         Post[]
  
  @@map("users")
}

