// Prisma schema for MySQL migration from Supabase
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User management (replacing auth.users from Supabase)
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String?   @map("full_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relations
  profile       Profile?
  posts         Post[]
  blogPosts     BlogPost[]
  userRoles     UserRole[]
  postLikes     PostLike[]
  comments      Comment[]
  chatMessages  ChatMessage[]
  eventRegistrations EventRegistration[]
  reports       Report[]
  
  @@map("users")
}

// Profiles
model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  fullName    String?  @map("full_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("profiles")
}

// User Roles
enum AppRole {
  admin
  moderator
  user
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, role])
  @@map("user_roles")
}

// Blog Posts (original posts table)
model BlogPost {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   @db.Text
  content     String   @db.LongText
  excerpt     String?  @db.Text
  coverImage  String?  @map("cover_image") @db.Text
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("blog_posts")
}

// Community Posts
model Post {
  id             String   @id @default(uuid())
  authorId       String   @map("author_id")
  authorName     String   @map("author_name") @db.Text
  authorAvatar   String?  @map("author_avatar") @db.Text
  content        String   @db.LongText
  channelId      String   @map("channel_id")
  imageUrl       String?  @map("image_url") @db.Text
  likes          Int      @default(0)
  commentsCount  Int      @default(0) @map("comments_count")
  isHidden       Boolean  @default(false) @map("is_hidden")
  reportCount    Int      @default(0) @map("report_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  author         User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channel        Channel     @relation(fields: [channelId], references: [id])
  postLikes      PostLike[]
  comments       Comment[]
  postHashtags   PostHashtag[]
  reports        Report[]
  
  @@index([channelId])
  @@index([authorId])
  @@map("posts")
}

// Hashtags
model Hashtag {
  id           String   @id @default(uuid())
  name         String   @unique @db.VarChar(191)
  postCount    Int      @default(0) @map("post_count")
  createdAt    DateTime @default(now()) @map("created_at")
  
  postHashtags PostHashtag[]
  
  @@map("hashtags")
}

// Post-Hashtag junction table
model PostHashtag {
  postId    String @map("post_id")
  hashtagId String @map("hashtag_id")
  
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  
  @@id([postId, hashtagId])
  @@map("post_hashtags")
}

// Channels
model Channel {
  id          String   @id
  name        String   @db.Text
  type        String   @default("text") @db.Text
  description String?  @db.Text
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  
  posts       Post[]
  chatMessages ChatMessage[]
  
  @@map("channels")
}

// Chat Messages
model ChatMessage {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  userName   String   @map("user_name") @db.Text
  userAvatar String?  @map("user_avatar") @db.Text
  message    String   @db.LongText
  channelId  String?  @map("channel_id")
  createdAt  DateTime @default(now()) @map("created_at")
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel? @relation(fields: [channelId], references: [id])
  
  @@index([channelId])
  @@index([userId])
  @@map("chat_messages")
}

// Post Likes
model PostLike {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@id([postId, userId])
  @@map("post_likes")
}

// Comments
model Comment {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  userId     String   @map("user_id")
  userName   String   @map("user_name") @db.Text
  userAvatar String?  @map("user_avatar") @db.Text
  content    String   @db.LongText
  createdAt  DateTime @default(now()) @map("created_at")
  
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([postId])
  @@index([userId])
  @@map("comments")
}

// Reports
model Report {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  reporterId String?  @map("reporter_id")
  reason     String   @db.Text
  status     String   @default("pending") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User?    @relation(fields: [reporterId], references: [id])
  
  @@index([postId])
  @@index([reporterId])
  @@map("reports")
}

// Events
model Event {
  id            String   @id @default(uuid())
  title         String   @db.Text
  description   String?  @db.LongText
  eventDate     DateTime @map("event_date")
  location      String?  @db.Text
  eventType     String   @default("meetup") @map("event_type") @db.Text
  maxAttendees  Int?     @map("max_attendees")
  image         String?  @db.Text
  price         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  
  registrations EventRegistration[]
  
  @@map("events")
}

// Event Registrations
model EventRegistration {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  userId         String?  @map("user_id")
  firstName      String   @map("first_name") @db.Text
  lastName       String   @map("last_name") @db.Text
  email          String   @db.Text
  attendeesCount Int      @default(1) @map("attendees_count")
  ticketCode     String   @default(uuid()) @map("ticket_code")
  status         String   @default("confirmed") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])
  
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

// Resources
model Resource {
  id          String   @id @default(uuid())
  title       String   @db.Text
  description String?  @db.LongText
  url         String?  @db.Text
  category    String   @default("documentation") @db.Text
  icon        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("resources")
}
